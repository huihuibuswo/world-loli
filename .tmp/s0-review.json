    },
    {
      "index": 10,
      "style": "Normal",
      "text": "露娜（确认追踪仍在持续，压住喘息）：断月纹还在追我。",
      "alignment": null,
      "runs": [
        {
          "text": "露娜（确认追踪仍在持续，压住喘息）：断月纹还在追我。",
          "bold": false,
          "italic": false,
          "size_pt": 10.5,
